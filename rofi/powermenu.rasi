configuration {
    show-icons:                 false;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  true;
    cursor:                      "default";
    background-color:            rgba(0, 0, 0, 0.60);
    border:                      0px;
    border-color:                rgba(255, 255, 255, 0.3);
    border-radius:               0px;

    padding:                     calc(50% - 100px) calc(50% - 250px);
}

mainbox {
    background-color:            #00000033;
    children:                    [ "listview" ];
}

listview {
    background-color:            #171723;
    border:                      2px;
    border-color:                rgba(255, 255, 255, 0.3);
    border-radius:               0px;
    padding:                     35px;
    spacing:                     20px;
    columns:                     2;
    lines:                       1;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
}

element {
    background-color:            #3F4253;
    text-color:                  #ffffff;
    orientation:                 vertical;
    border-radius:               0px;
    padding:                     25px 0px;
    cursor:                      pointer;
}

element selected {
    background-color:            #B0CCE6;
    text-color:                  #000000;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    font:                        "JetBrainsMono Nerd Font 28";
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
