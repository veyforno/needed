#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    browser_column_widths: [20, 30, 60],
    symbols: (song: "   ",dir: "   ",marker: " ",ellipsis: "..."),
    text_color: "#E0E0E0",
    tab_bar: (
        enabled: true,
        active_style: (bg:"#1A1A1A" ,fg: "#FFFFFF", modifiers: "Bold"),
        inactive_style: (fg: "#707070", modifiers: ""),
    ),
    highlighted_item_style: (fg: "#FFFFFF", modifiers: "Bold"),
    current_item_style: (fg: "#FFFFFF", bg: "#1A1A1A", modifiers: "Bold"),
    borders_style: (fg: "#404040", modifiers: "Bold"),
    highlight_border_style: (fg: "#FFFFFF"),
    progress_bar: (
        symbols: ["┄", "┅", "━"],
        track_style: (fg: "#202020"),
        elapsed_style: (fg: "#FFFFFF"),
        thumb_style: (fg: "#FFFFFF"),
    ),
    scrollbar: (
        symbols: ["", "", "", ""],
        track_style: (fg: "#404040"),
        ends_style: (fg: "#404040"),
        thumb_style: (fg: "#FFFFFF"),
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
            (kind: Property(Title)),
            (kind: Text(" - ")),
            (kind: Property(Artist)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "#E0E0E0"),
                highlighted_item_style: (fg: "#000000", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "#404040"),)
            ),
            width: "50%",
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "#A0A0A0"),
                default: (kind: Text("Unknown Artist"), style: (fg: "#707070"))
            ),
            width: "45%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#FFFFFF")),
            width: "10%",
            alignment: Right,
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Property(Status(StateV2(playing_label: "playin", paused_label: "paused", stopped_label: "shut up"))), style: (fg: "#FFFFFF", modifiers: "Bold")),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#FFFFFF",modifiers: "Bold"),
                        default: (kind: Property(Song(Filename)), style: (fg: "#FFFFFF",modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#FFFFFF", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#FFFFFF", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#FFFFFF", modifiers: "Bold"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)),style: (fg: "#E0E0E0")),
                    (kind: Text("/"),style: (fg: "#404040")),
                    (kind: Property(Status(Duration)),style: (fg: "#E0E0E0")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#A0A0A0", modifiers: "Bold"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#707070", modifiers: "Bold"))
                    ),
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#FFFFFF", modifiers: "Bold"),
                            separator_style: (fg: "#707070")))
                        ),
                        style: (fg: "#707070")
                    ),
                ]
            ),
        ],
    ),
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                    (
                            size: "100%",
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                (
                                        size: "4",
                                        borders: "ALL",
                                        pane: Pane(Header),
                                    ),
                                ]
                            )
                        ),
                    ]
                ),
            ),
            (
                size: "3",
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "100%",
                            borders: "NONE",
                            pane: Pane(TabContent),
                        ),
                    ]
                ),
            ),
            (
                size: "3",
                borders: "TOP | BOTTOM",
                pane: Pane(ProgressBar),
            ),
        ],
    ),
)
